set(qt_components Core Widgets Concurrent Network Test Xml Svg)
if(NOT APPLE AND NOT WIN32)
    list(APPEND qt_components DBus)
endif()

if(Launcher_QT_MAJOR STREQUAL "6")
    list(APPEND qt_components Core5Compat OpenGL)
    find_package(Qt6 6.0 REQUIRED COMPONENTS ${qt_components})
    if(Qt6_VERSION VERSION_EQUAL "6.0.0" AND CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
        # Qt 6.0.0 headers use std::numeric_limits without including <limits>.
        add_compile_options("$<$<COMPILE_LANGUAGE:CXX>:-include>" "$<$<COMPILE_LANGUAGE:CXX>:limits>")
    endif()
else()
    find_package(Qt5 5.6.3 REQUIRED COMPONENTS ${qt_components})
endif()

add_library(Launcher_qt_compat INTERFACE)
target_include_directories(Launcher_qt_compat INTERFACE "${CMAKE_CURRENT_SOURCE_DIR}/libraries/qtcompat")
if(Launcher_QT_MAJOR STREQUAL "6")
    target_link_libraries(Launcher_qt_compat INTERFACE Qt6::Core5Compat)
endif()

macro(launcher_qt_wrap_ui)
    if(Launcher_QT_MAJOR STREQUAL "6")
        qt6_wrap_ui(${ARGV})
    else()
        qt5_wrap_ui(${ARGV})
    endif()
endmacro()

macro(launcher_qt_add_resources)
    if(Launcher_QT_MAJOR STREQUAL "6")
        qt6_add_resources(${ARGV})
    else()
        qt5_add_resources(${ARGV})
    endif()
endmacro()

include(QMakeQuery)
query_qmake(QUERY QT_INSTALL_PLUGINS RESULT QT_PLUGINS_DIR)
query_qmake(QUERY QT_INSTALL_LIBS RESULT QT_LIBS_DIR)
query_qmake(QUERY QT_INSTALL_LIBEXECS RESULT QT_LIBEXECS_DIR)

if(Qt${Launcher_QT_MAJOR}_POSITION_INDEPENDENT_CODE)
    set(CMAKE_POSITION_INDEPENDENT_CODE ON)
endif()
