msgstr "GameMode daemon: draaien - zal activeren bij het opstarten van het spel (%1)"

#: plugins/LinuxPerf/LinuxPerfPlugin.cpp:117
msgctxt "QObject|"
msgid "GameMode daemon: not reachable from sandbox — add session bus access to\n"
"com.feralinteractive.GameMode and ensure the host gamemoded service is running"
msgstr "Spelmodus daemon: niet bereikbaar vanuit sandbox - voeg sessie bus toegang toe aan\n"
"com.feralinteractive.GameMode en zorg ervoor dat de gamemoded van de host wordt uitgevoerd"

#: plugins/LinuxPerf/LinuxPerfPlugin.cpp:123
msgctxt "QObject|"
msgid "GameMode daemon: not responding — run \"systemctl --user enable --now gamemoded\" or check gamemode install"
msgstr "GameMode daemon: niet reageren: voer \"systemctl --user enable --now gamemoded\" of controleer de installatie van gamemode"

