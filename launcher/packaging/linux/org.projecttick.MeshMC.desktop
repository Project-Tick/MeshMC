[Desktop Entry]
Version=1.5
Type=Application
Name=MeshMC
GenericName=Minecraft Launcher
Comment=Discover, manage, and play Minecraft instances
Exec=meshmc %U
Icon=org.projecttick.MeshMC
Terminal=false
StartupNotify=true
StartupWMClass=MeshMC
Categories=Game;
Keywords=game;minecraft;mc;launcher;modpack;mod;
MimeType=application/zip;application/x-modrinth-modpack+zip;x-scheme-handler/curseforge;x-scheme-handler/meshmc;
