[submodule "flatpak/shared-modules"]
	path = flatpak/shared-modules
	url = https://github.com/flathub/shared-modules.git

[submodule "libraries/flite"]
	path = libraries/flite
	url = https://github.com/festvox/flite.git
	branch = master
	shallow = true

[submodule "libraries/libdecor"]
	path = libraries/libdecor
	url = https://gitlab.freedesktop.org/libdecor/libdecor.git
	branch = master
	shallow = true

[submodule "libraries/libXrandr"]
	path = libraries/libXrandr
	url = https://gitlab.freedesktop.org/xorg/lib/libxrandr.git
	branch = master
	shallow = true
