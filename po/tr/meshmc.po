#: launcher/ui/pages/instance/LegacyUpgradePage.cpp:59
#, kde-format
msgid "%1 (Migrated)"
msgstr "%1 (Taşındı)"

#: launcher/ui/pages/instance/LegacyUpgradePage.h:45
#, kde-format
msgid "Upgrade"
msgstr "Yükselt"

#: launcher/ui/pages/instance/LegacyUpgradePage.ui:29
#, kde-format
msgid ""
"<html><body><h1>Upgrade is required</h1><p>MeshMC now supports old Minecraft "
"versions and all the required features in the new (OneSix) instance format. "
"As a consequence, the old (Legacy) format has been entirely disabled and old "
"instances need to be upgraded.</p><p>The upgrade will create a new instance "
"with the same contents as the current one, in the new format. The original "
"instance will remain untouched, in case anything goes wrong in the process.</"
"p><p>Please report any issues on our <a href=\"https://github.com/Project-"
"Tick/MeshMC/issues\">GitHub page</a>.</p><p>There is also a <a "
"href=\"https://discord.gg/PMxPTqwEwj\">discord channel for testing here</a>."
"</p></body></html>"
msgstr ""
"<html><body><h1>Yükseltme gerekiyor</h1><p>MeshMC artık eski Minecraft "
"sürümlerini ve yeni (OneSix) örnek biçimindeki tüm gerekli özellikleri "
"destekliyor. Bu nedenle, eski (Legacy) biçim tamamen devre dışı bırakıldı ve "
"mevcut örneklerin yükseltilmesi gerekiyor.</p><p>Yükseltme işlemi, mevcut "
"örneğinizle aynı içeriğe sahip, yeni biçimde bir örnek oluşturacaktır. İşlem "
"sırasında bir sorun yaşanması ihtimaline karşı, orijinal örneğiniz olduğu "
"gibi korunacaktır.</p><p>Karşılaştığınız sorunları lütfen <a href=\"https://"
"github.com/Project-Tick/MeshMC/issues\">GitHub sayfamız</a> üzerinden "
"bildirin.</p><p>Ayrıca, test süreçleri için bir <a href=\"https://discord.gg/"
"PMxPTqwEwj\">Discord kanalımız</a> da mevcuttur.</p></body></html>"

