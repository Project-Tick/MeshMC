#, kde-format
msgid "Upgrade"
msgstr "Opgradér"

#: launcher/ui/pages/instance/LegacyUpgradePage.ui:29
#, kde-format
msgid ""
"<html><body><h1>Upgrade is required</h1><p>MeshMC now supports old Minecraft "
"versions and all the required features in the new (OneSix) instance format. "
"As a consequence, the old (Legacy) format has been entirely disabled and old "
"instances need to be upgraded.</p><p>The upgrade will create a new instance "
"with the same contents as the current one, in the new format. The original "
"instance will remain untouched, in case anything goes wrong in the process.</"
"p><p>Please report any issues on our <a href=\"https://github.com/Project-"
"Tick/MeshMC/issues\">GitHub page</a>.</p><p>There is also a <a "
"href=\"https://discord.gg/PMxPTqwEwj\">discord channel for testing here</a>."
"</p></body></html>"
msgstr ""
"<html><body><h1>Opgradering kræves</h1><p>MeshMC understøtter nu gamle "
"Minecraft versioner og alle de nødvendige funktioner i det nye (OneSix) "
"instans format. Som følge heraf er det gamle (Legacy) format blevet helt "
"deaktiveret, og gamle tilfælde skal opgraderes.</p><p>Opgraderingen vil "
"oprette en ny instans med samme indhold som den nuværende, i det nye format. "
"Det oprindelige eksempel vil forblive uberørt, hvis noget går galt i "
"processen.</p><p>Rapporter venligst eventuelle problemer på vores <a "
"href=\"https://github.com/Project-Tick/MeshMC/issues\">GitHub side</a>.</"
"p><p>Der er også en <a href=\"https://discord.gg/PMxPTqwEwj\">discord kanal "
"til test her</a>.</p></body></html>"

