msgstr "Hledat…"

#: plugins/OfflineWiki/WikiPage.cpp:95
msgctxt "WikiPage|"
msgid "<h3>Wiki not available</h3><p>The MeshMC wiki is downloaded automatically using <b>git</b>, but no <code>git</code> program was found on your system, so the wiki cannot be fetched.</p><p>Install Git and restart MeshMC to download the wiki.</p>"
msgstr "<h3>Wiki není k dispozici</h3><p>Wiki je stažena automaticky pomocí <b>git</b>, ale ve vašem systému nebyl nalezen žádný <code>git</code> , takže wiki nelze načíst.</p><p>Nainstalujte Git a restartujte MeshMC pro stažení wiki.</p>"

#: plugins/OfflineWiki/WikiPage.cpp:102
msgctxt "WikiPage|"
msgid "<h3>Downloading the MeshMC wiki…</h3><p>The wiki is fetched in the background the first time you are online and will appear here automatically once the download finishes. If you are offline, MeshMC retries on every launch.</p>"
msgstr "<h3>Stahování MeshMC wiki…</h3><p>Wiki je načteno na pozadí poprvé při Vašem připojení a zobrazí se zde automaticky, jakmile stahování skončí. Pokud jste offline, MeshMC se znovu pokusí při každém spuštění.</p>"

#: plugins/OfflineWiki/WikiPage.cpp:128
#, qt-format
msgctxt "WikiPage|"
msgid "<p><i>Article not found: %1</i></p>"
msgstr "<p><i>Článek nebyl nalezen: %1</i></p>"

