msgctxt "QObject|"
msgid "GameMode is not available inside this Flatpak sandbox.\n"
"Bundle the GameMode client tools in the Flatpak and allow access to\n"
"com.feralinteractive.GameMode on the session bus."
msgstr "GameMode není dostupný uvnitř tohoto Flatpak sandboxu.\n"
"Sbalte klientské nástroje GameMode ve Flatpak a povolte přístup k\n"
"com.feralinteractive.GameMode na sběrnici relací."

#: plugins/LinuxPerf/LinuxPerfPlugin.cpp:101
msgctxt "QObject|"
msgid "gamemoderun is not installed or not found on PATH.\n"
"Install GameMode and restart MeshMC to enable this option."
msgstr "gamemoderun není nainstalován nebo nenalezen na PATH.\n"
"Nainstalujte GameMode a restartujte MeshMC pro povolení této možnosti."

