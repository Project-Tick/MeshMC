<component type="desktop">
  <id>org.projecttick.MeshMC</id>
  <name>MeshMC</name>
  <summary>Custom Minecraft Launcher to easily manage multiple Minecraft installations at once with MMCO Plugins</summary>
  <developer id="org.projecttick">
    <name>Project Tick</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <description>
    <p>MeshMC is a custom launcher for Minecraft that focuses on predictability, long term stability and simplicity. With MMCO Plugin system.</p>
    <p>Features:</p>
    <ul>
      <li>Easily install game modifications, such as Fabric, Forge, NeoForge and Quilt</li>
      <li>Easily install and update modpacks from the MeshMC</li>
      <li>Control your Java settings</li>
      <li>Ability to install MMCO plugin from outside</li>
      <li>Ability to use proprietary plugins signed with MMCS.</li>
      <li>Manage worlds and resource packs from the launcher</li>
      <li>See logs and other details easily through a dashboard</li>
      <li>Kill Minecraft in case of a crash/freeze</li>
      <li>Ability to disable MMCO plugins you don't want.</li>
      <li>Isolate Minecraft instances to keep everything clean</li>
      <li>Install and update mods directly from the launcher</li>
      <li>Customize the launcher with themes, and more</li>
      <li>And cats :3</li>
      <li>With more themes, UwU</li>
    </ul>
  </description>
  <screenshots>
    <screenshot type="default">
      <caption>The main MeshMC window</caption>
      <image type="source" width="1030" height="764">https://projecttick.org/img/screenshots/MeshMC-7.11.0-dark-MainWindow.png</image>
    </screenshot>
    <screenshot>
      <caption>View MeshMC with your cats</caption>
      <image type="source" width="1030" height="764">https://projecttick.org/img/screenshots/MeshMC-7.11.0-dark-MainWindow-With-Catpack.png</image>
    </screenshot>
    <screenshot>
      <caption>Manage instance version, modloaders and more</caption>
      <image type="source" width="1030" height="764">https://projecttick.org/img/screenshots/MeshMC-7.11.0-dark-InstanceSettings-Version.png</image>
    </screenshot>
    <screenshot>
      <caption>Create your new vanilla instance with MeshMC</caption>
      <image type="source" width="1030" height="764">https://projecttick.org/img/screenshots/MeshMC-7.11.0-dark-NewInstance-Vanilla.png</image>
    </screenshot>
    <screenshot>
      <caption>Manage your instance backups</caption>
      <image type="source" width="1030" height="764">https://projecttick.org/img/screenshots/MeshMC-7.11.0-dark-InstanceSettings-Backups.png</image>
    </screenshot>
    <screenshot>
      <caption>Language selection</caption>
      <image type="source" width="1030" height="764">https://projecttick.org/img/screenshots/MeshMC-7.11.0-dark-Settings-Language.png</image>
    </screenshot>
    <screenshot>
      <caption>Download java from vendors</caption>
      <image type="source" width="1030" height="764">https://projecttick.org/img/screenshots/MeshMC-7.11.0-dark-Settings-Java-Installations.png</image>
    </screenshot>
  </screenshots>
  <recommends>
    <memory>2048</memory>
  </recommends>
@MeshMC_METAINFO_RELEASES@
  <categories>
    <category>Game</category>
  </categories>
  <url type="homepage">https://projecttick.org/p/meshmc</url>
  <url type="faq">https://projecttick.org/handbook</url>
  <url type="help">https://projecttick.org/handbook/</url>
  <url type="bugtracker">https://git.projecttick.org/project-tick/projects/meshmc/-/work_items</url>
  <url type="translate">https://crowdin.com/project/projtlauncher</url>
  <url type="contact">mailto:meshmc-helpdesk@projecttick.org</url>
  <url type="vcs-browser">https://git.projecttick.org/project-tick/projects/meshmc/</url>
  <url type="contribute">https://git.projecttick.org/project-tick/governance/governancedoc/-/blob/master/GOVERNANCE.md</url>
  <content_rating type="oars-1.1">
    <content_attribute id="violence-fantasy">moderate</content_attribute>
    <content_attribute id="social-chat">intense</content_attribute>
    <content_attribute id="social-info">moderate</content_attribute>
  </content_rating>
  <branding>
    <color type="primary" scheme_preference="light">#3584e4</color>
    <color type="primary" scheme_preference="dark">#0a2d6f</color>
  </branding>
  <launchable type="desktop-id">@MeshMC_AppID@.desktop</launchable>
</component>
