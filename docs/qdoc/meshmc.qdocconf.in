# Generated by docs/CMakeLists.txt -- do not edit this copy.
#
# The template lives at docs/qdoc/meshmc.qdocconf.in. Everything that a build
# system already knows is filled in from there rather than repeated here: the
# product version, the source list, and the include paths QDoc hands to clang.
# An earlier version of this file kept those by hand, which meant a new entry
# under libraries/ silently stopped being parsed.

# Qt's own configuration reads these before anything else and aborts with
# "Environment or configuration variable 'QT_VERSION' undefined" if they are
# missing. Defined here rather than exported into the environment, so that
# running qdoc on this file needs no wrapper.
QT_VERSION      = @MeshMC_DOCS_QT_VERSION@
QT_VER          = @MeshMC_DOCS_QT_VER@
QT_VERSION_TAG  = @MeshMC_DOCS_QT_VERSION_TAG@
QT_INSTALL_DOCS = @MeshMC_DOCS_QT_INSTALL_DOCS@
BUILDDIR        = @MeshMC_DOCS_OUTPUT_DIR@

include(@MeshMC_DOCS_QT_INSTALL_DOCS@/global/qt-module-defaults.qdocconf)

project     = MeshMC
description = MeshMC Internals
productname = MeshMC
version     = @MeshMC_RELEASE_VERSION_NAME@

outputformats  = HTML
outputencoding = UTF-8
outputdir      = @MeshMC_DOCS_OUTPUT_DIR@

# The launcher's own sources, taken from the MeshMC_logic target. Two things
# follow from that and both are wanted: the unit tests are absent, because
# they belong to their own targets, and a file starts being documented the
# moment it is added to the build.
#
# QDoc reads documentation comments only from `sources`. `headerdirs` is for
# resolving declarations -- a class named there is found and its base classes
# and signatures come out right, but a comment sitting in a header is not read
# unless the header is in the list below, which is why headers are in it.
sources = @MeshMC_DOCS_SOURCES@

headerdirs = @CMAKE_SOURCE_DIR@/launcher

sources.fileextensions = "*.cpp *.cc *.cxx *.mm *.h *.hpp"
headers.fileextensions = "*.h *.hpp *.hxx"

# QDoc parses with clang and needs what a compiler needs. From the target's
# INCLUDE_DIRECTORIES plus the Qt modules the launcher is built against.
includepaths += @MeshMC_DOCS_INCLUDEPATHS@

# So that a mention of QString or QWidget becomes a link into Qt's own
# documentation instead of a reported broken link.
depends = qtcore qtgui qtwidgets qtnetwork

# No moduleheader is set, and it must stay that way. MeshMC is an application,
# not a Qt module, so there is no single header that includes everything --
# and when QDoc cannot find one it builds an artificial header out of
# headerdirs instead, which is what makes the launcher's classes visible to
# \class. Setting `moduleheader =` to silence the notice about that disables
# the fallback: QDoc then finds no classes at all and reports "Cannot find 'X'
# specified with '\class' in any header file".

# Qt's defaults arrive with Qt's own footer: The Qt Company's copyright, the
# GNU Free Documentation License, and Qt's trademark notice. None of that
# describes MeshMC, which is Apache-2.0. The five closing <div>s are not
# decoration -- Qt's header opens them.
buildversion = "MeshMC @MeshMC_RELEASE_VERSION_NAME@ internals"

HTML.footer = \
    "        </div>\n" \
    "       </div>\n" \
    "   </div>\n" \
    "   </div>\n" \
    "</div>\n" \
    "<div class=\"footer\">\n" \
    "   <p>\n" \
    "   <abbr title=\"Copyright\">&copy;</abbr> 2026 Project Tick.\n" \
    "   Generated from MeshMC's own sources by QDoc, and licensed under the\n" \
    "   <a href=\"https://www.apache.org/licenses/LICENSE-2.0\">Apache License,\n" \
    "   Version 2.0</a> -- the same terms as the code it describes.</p>\n" \
    "</div>\n"

# Qt's config.qdocconf sets this to "$productname $QT_VER", which renders as
# "MeshMC 6.11" -- MeshMC labelled with Qt's version number.
navigation.hometitle = "MeshMC @MeshMC_RELEASE_VERSION_NAME@"
